# Sourced by uwsm before the compositor starts, so these reach both
# Hyprland's children and systemd user units.
# Omarchy already sets cursor size, QT_QPA_PLATFORM, GDK_BACKEND, the XDG
# session vars and QT_IM_MODULE; SSH_AUTH_SOCK comes from
# omarchy-setup-security-ssh-agent.

export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
